# Dedicated AEMS Supabase Configuration (Never use ATM-SIG credentials)
NEXT_PUBLIC_SUPABASE_URL=https://your-aems-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only privileged key (for cron consistency jobs or admin bootstrap only; never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Database and authentication must both use the dedicated AEMS Supabase project.
# Production refuses to fall back to sample data when configuration is missing.
AEMS_STORAGE_MODE=supabase

# Optional local/offline development only: AEMS_STORAGE_MODE=local-store
# Never enable sample role switching or reset controls in production.
NEXT_PUBLIC_AEMS_DEMO_MODE=false
