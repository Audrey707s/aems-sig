# Dedicated AEMS Supabase Configuration (Never use ATM-SIG credentials)
NEXT_PUBLIC_SUPABASE_URL=https://your-aems-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only privileged key (for cron consistency jobs or admin bootstrap only; never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Application Mode ("local-store" | "supabase")
# When NEXT_PUBLIC_SUPABASE_URL is not configured or AEMS_STORAGE_MODE=local-store,
# AEMS runs with its deterministic transactional in-memory/file engine enforcing all R.02 DB rules.
AEMS_STORAGE_MODE=local-store
